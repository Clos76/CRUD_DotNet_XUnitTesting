@model IEnumerable<PersonResponse>



@{
	ViewBag.Title = "Persons";
}

<h1>Persons</h1>
<div class="box flex">

	<div class="flex-1">
		<select class="form-input"></select>
	</div>


	<div class="flex-1">
		<input type="search"
			   name="search"
			   id="search"
			   class="form-input"
			   placeholder="Search..." />
	</div>


	<div class="flex-1">

		<button class="btn btn-primary">
			<i class="fa-solid fa-magnifying-glass"></i>
			Search
		</button>


		<a href="~/persons/index"
			   class="btn btn-secondary">
			<i class="link-hover"></i>
			Clear All
		</a>

	</div>

</div>
<table class="table">
	<thead>
		<tr>
			<th>Person Name</th>
			<th>Email</th>
			<th>Date of Birth</th>
			<th>Age</th>
			<th>Gender</th>
			<th>Country</th>
			<th>Address</th>
			<th>Receive News Letters</th>
		</tr>
	</thead>
	<tbody>
		@foreach(PersonResponse person in Model)
		{
			<tr>
				<td>@person.PersonName</td>
				<td>@person.Email</td>
				<td>@person.DateOfBirth?.ToString("dd MM yyyy")</td>
				<td>@person.Age</td>
				<td>@person.Gender</td>
				<td>@person.Country</td>
				<td>@person.Address</td>
				<td>@person.ReceiveNewsLetters</td>
			</tr>
		}
		<tr></tr>
	</tbody>

</table>